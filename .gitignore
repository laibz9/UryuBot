# ==========================================
# UryuBot - Enterprise Production Git Ignore
# ==========================================

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
package-lock.json.bak
yarn.lock
pnpm-lock.yaml

# Environment Variables, Secrets & Keys
.env
.env.*
!.env.example
*.pem
*.key
*.pub
id_rsa*

# Temporary Transcripts, Uploads & Cache
transcripts/*.html
!transcripts/.gitkeep
temp/
tmp/
.cache/
dist/
build/

# Testing, Scratch & Audit Scripts
test_*.js
run_*.js
check_*.js
scratch/

# Logs & Process Monitor
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE, Editor & Agent Directories
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.gemini/
.agents/
