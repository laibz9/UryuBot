# ==========================================
# UryuBot - Global Multi-Server Configuration
# ==========================================

# 1. ข้อมูลบอทจาก Discord Developer Portal
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE

# 2. ระบบ Web Dashboard & Discord OAuth2 Login (สำหรับ Server Owner)
PORT=3000
CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET_HERE
REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=uryu_secure_session_key_2026

# 3. การเชื่อมต่อฐานข้อมูล MySQL Server (mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uryubot_db

# ==========================================
# 💡 หมายเหตุสำคัญ:
# การตั้งค่ายศ (Roles), ช่องแชท (Channels), Verify, ต้อนรับ, เพลง, ทิกเก็ต ของแต่ละเซิร์ฟเวอร์
# สามารถเลือกและกดบันทึกผ่านหน้าเว็บ http://localhost:3000 ได้โดยตรงแบบ Realtime (ไม่ต้องกรอกใน .env อีกต่อไป)
# ==========================================
