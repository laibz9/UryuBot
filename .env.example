# Discord Bot Configuration
# Token ของ Discord Bot ที่ได้จาก Discord Developer Portal
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Client ID (Application ID) ของบอท
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Guild ID (Server ID) สำหรับลงทะเบียน Slash Command ในเซิร์ฟเวอร์แบบทันที
GUILD_ID=YOUR_GUILD_ID_HERE

# ID ของ Role ที่จะแจกให้สมาชิกเมื่อผ่านการยืนยันตัวตนสำเร็จ
VERIFIED_ROLE_ID=YOUR_VERIFIED_ROLE_ID_HERE

# ID ของ Role หัวหน้าใหญ่/เจ้าของเซิร์ฟเวอร์, ผู้ดูแลระบบ และผู้ควบคุมความสงบเรียบร้อย
LEADER_ROLE_ID=YOUR_LEADER_ROLE_ID_HERE
ADMIN_ROLE_ID=YOUR_ADMIN_ROLE_ID_HERE
MODERATOR_ROLE_ID=YOUR_MODERATOR_ROLE_ID_HERE

# ID ของช่อง Text Channel สำหรับแจ้งเตือนต้อนรับและบอกลาสมาชิก
WELCOME_CHANNEL_ID=YOUR_WELCOME_CHANNEL_ID_HERE
GOODBYE_CHANNEL_ID=YOUR_GOODBYE_CHANNEL_ID_HERE

# เปิด-ปิด ระบบต้อนรับและบอกลา (true = เปิดใช้งาน, false = ปิดใช้งาน)
ENABLE_WELCOME_SYSTEM=true

# ID ของช่องสำหรับเก็บบันทึกประวัติกิจกรรม (Audit Log Channel เช่น ข้อความถูกลบ/แก้ไข)
LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID_HERE

# เปิด-ปิด ระบบเก็บบันทึกประวัติ (true = เปิดใช้งาน, false = ปิดใช้งาน)
ENABLE_LOG_SYSTEM=true

# ID ของ Category สำหรับสร้างห้อง Ticket (ใส่หรือไม่ใส่ก็ได้ หากไม่ใส่จะสร้างไว้ในหมวดหมู่ทั่วไป)
TICKET_CATEGORY_ID=YOUR_TICKET_CATEGORY_ID_HERE

# ID ของห้องสำหรับขอเพลงและแผงเครื่องเล่นเพลงถาวร (Dedicated Music Request Channel)
MUSIC_CHANNEL_ID=YOUR_MUSIC_CHANNEL_ID_HERE

# Web Dashboard & Discord OAuth2 Login (สำหรับ Server Owner เท่านั้น)
PORT=3000
CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET_HERE
REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=uryu_secure_session_key_2026

# MySQL Database Configuration (mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uryubot_db

